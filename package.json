{
  "name": "acp-client",
  "displayName": "ACP Client: Universal AI Agent Protocol",
  "description": "Connect VS Code to any AI coding agent via the Agent Client Protocol (ACP). Seamlessly integrate with GitHub Copilot, Claude Code, Gemini, and other ACP-compatible agents.",
  "version": "0.2.1",
  "publisher": "damien-huyet",
  "license": "MIT",
  "icon": "resources/icon.png",
  "bugs": {
    "url": "https://github.com/maurice30120/vscode-acp/issues"
  },
  "homepage": "https://github.com/maurice30120/vscode-acp/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/maurice30120/vscode-acp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "acp",
    "agent",
    "ai",
    "coding agent",
    "copilot"
  ],
  "activationEvents": [
    "onCommand:damien.inlineChat.open"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acp-client",
          "title": "ACP Client",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "acp-client": [
        {
          "id": "acp-sessions",
          "name": "Agents",
          "type": "tree"
        },
        {
          "id": "acp-chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "acp-sessions",
        "contents": "No agents configured.\n[Add Agent](command:acp.addAgent)\nConfigure agents in settings or browse the [Agent Registry](command:acp.browseRegistry)."
      },
      {
        "view": "acp-chat",
        "contents": "Start chatting with an AI coding agent.\n[Connect to Agent](command:acp.connectAgent)\nSelect an agent from the list above to begin."
      }
    ],
    "commands": [
      {
        "command": "damien.inlineChat.open",
        "title": "Damien: Inline Chat"
      },
      {
        "command": "acp.connectAgent",
        "title": "ACP: Connect to Agent",
        "icon": "$(plug)"
      },
      {
        "command": "acp.connectAgentWithCurrentContext",
        "title": "ACP: Connect With Current Context",
        "icon": "$(references)"
      },
      {
        "command": "acp.newConversation",
        "title": "ACP: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "acp.sendPrompt",
        "title": "ACP: Send Prompt"
      },
      {
        "command": "acp.cancelTurn",
        "title": "ACP: Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acp.disconnectAgent",
        "title": "ACP: Disconnect Agent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "acp.openChat",
        "title": "ACP: Open Chat Panel"
      },
      {
        "command": "acp.openChatEditor",
        "title": "ACP: Open Chat in Editor"
      },
      {
        "command": "acp.moveChatToEditor",
        "title": "ACP: Move Chat to Editor"
      },
      {
        "command": "acp.addAgent",
        "title": "ACP: Add Agent Configuration",
        "icon": "$(add)"
      },
      {
        "command": "acp.removeAgent",
        "title": "ACP: Remove Agent"
      },
      {
        "command": "acp.showLog",
        "title": "ACP: Show Log"
      },
      {
        "command": "acp.showTraffic",
        "title": "ACP: Show Protocol Traffic"
      },
      {
        "command": "acp.openDebugSnapshot",
        "title": "ACP: Open Debug Snapshot",
        "icon": "$(bug)"
      },
      {
        "command": "acp.browseRegistry",
        "title": "ACP: Browse Agent Registry"
      },
      {
        "command": "acp.setMode",
        "title": "ACP: Set Agent Mode"
      },
      {
        "command": "acp.setModel",
        "title": "ACP: Set Agent Model"
      },
      {
        "command": "acp.enableEditorContextLink",
        "title": "ACP: Enable Editor Context Link",
        "icon": "$(pin)",
        "when": "!acp.editorContextLinked"
      },
      {
        "command": "acp.disableEditorContextLink",
        "title": "ACP: Disable Editor Context Link",
        "icon": "$(pinned)",
        "when": "acp.editorContextLinked"
      },
      {
        "command": "acp.refreshAgents",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "acp.enablePipelineAgents",
        "title": "ACP: Enable Pipeline Agents",
        "icon": "$(play)"
      },
      {
        "command": "acp.disablePipelineAgents",
        "title": "ACP: Disable Pipeline Agents",
        "icon": "$(debug-pause)"
      },
      {
        "command": "acp.enableSandbox",
        "title": "ACP: Enable Sandbox",
        "icon": "$(beaker)"
      },
      {
        "command": "acp.disableSandbox",
        "title": "ACP: Disable Sandbox",
        "icon": "$(beaker)"
      },
      {
        "command": "acp.toggleSandbox",
        "title": "ACP: Toggle Sandbox"
      },
      {
        "command": "acp.runInSandbox",
        "title": "ACP: Run in Sandbox",
        "icon": "$(beaker)"
      },
      {
        "command": "acp.sandbox.promote",
        "title": "ACP: Promote Sandbox Changes"
      },
      {
        "command": "acp.sandbox.discard",
        "title": "ACP: Discard Sandbox"
      },
      {
        "command": "acp.sandbox.cleanup",
        "title": "ACP: Cleanup Stale Sandboxes"
      },
      {
        "command": "acp.sandcastle.showDiff",
        "title": "ACP: Sandcastle Show Diff"
      },
      {
        "command": "acp.sandcastle.apply",
        "title": "ACP: Sandcastle Apply Changes"
      },
      {
        "command": "acp.sandcastle.reject",
        "title": "ACP: Sandcastle Reject Changes"
      },
      {
        "command": "acp.showCompiledTeamPipeline",
        "title": "ACP: Show Compiled Team Pipeline"
      },
      {
        "command": "acp.rerunTeamReviewer",
        "title": "ACP: Re-run Team Reviewer"
      },
      {
        "command": "acp.refreshSessions",
        "title": "ACP: Refresh Sessions"
      },
      {
        "command": "acp.openSession",
        "title": "ACP: Open Session"
      },
      {
        "command": "acp.openSessionWithCurrentContext",
        "title": "ACP: Open Session With Current Context",
        "icon": "$(references)"
      },
      {
        "command": "acp.loadMoreSessions",
        "title": "ACP: Load More Sessions"
      },
      {
        "command": "acp.copySessionId",
        "title": "Copy Session ID"
      },
      {
        "command": "acp.forgetSession",
        "title": "Forget Session"
      },
      {
        "command": "acp.restartAgent",
        "title": "ACP: Restart Agent",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "acp.openSession",
          "when": "false"
        },
        {
          "command": "acp.connectAgentWithCurrentContext",
          "when": "false"
        },
        {
          "command": "acp.openSessionWithCurrentContext",
          "when": "false"
        },
        {
          "command": "acp.loadMoreSessions",
          "when": "false"
        },
        {
          "command": "acp.copySessionId",
          "when": "false"
        },
        {
          "command": "acp.forgetSession",
          "when": "false"
        },
        {
          "command": "acp.enableEditorContextLink",
          "when": "!acp.editorContextLinked"
        },
        {
          "command": "acp.disableEditorContextLink",
          "when": "acp.editorContextLinked"
        },
        {
          "command": "acp.enablePipelineAgents",
          "when": "!acp.pipelineEnabled"
        },
        {
          "command": "acp.disablePipelineAgents",
          "when": "acp.pipelineEnabled"
        },
        {
          "command": "acp.enableSandbox",
          "when": "!acp.sandboxEnabled"
        },
        {
          "command": "acp.disableSandbox",
          "when": "acp.sandboxEnabled"
        },
        {
          "command": "acp.toggleSandbox"
        }
      ],
      "view/title": [
        {
          "command": "acp.addAgent",
          "when": "view == acp-sessions",
          "group": "navigation@1"
        },
        {
          "command": "acp.refreshAgents",
          "when": "view == acp-sessions",
          "group": "navigation@3"
        },
        {
          "command": "acp.enablePipelineAgents",
          "when": "view == acp-sessions && !acp.pipelineEnabled",
          "group": "navigation@2"
        },
        {
          "command": "acp.disablePipelineAgents",
          "when": "view == acp-sessions && acp.pipelineEnabled",
          "group": "navigation@2"
        },
        {
          "command": "acp.enableSandbox",
          "when": "view == acp-sessions && !acp.sandboxEnabled",
          "group": "navigation@4"
        },
        {
          "command": "acp.disableSandbox",
          "when": "view == acp-sessions && acp.sandboxEnabled",
          "group": "navigation@4"
        },
        {
          "command": "acp.browseRegistry",
          "when": "view == acp-sessions"
        },
        {
          "command": "acp.newConversation",
          "when": "view == acp-chat",
          "group": "navigation@1"
        },
        {
          "command": "acp.openChatEditor",
          "when": "view == acp-chat",
          "group": "navigation@0"
        },
        {
          "command": "acp.enableEditorContextLink",
          "when": "view == acp-chat && !acp.editorContextLinked",
          "group": "navigation@3"
        },
        {
          "command": "acp.disableEditorContextLink",
          "when": "view == acp-chat && acp.editorContextLinked",
          "group": "navigation@3"
        },
        {
          "command": "acp.enableSandbox",
          "when": "view == acp-chat && !acp.sandboxEnabled",
          "group": "navigation@2"
        },
        {
          "command": "acp.disableSandbox",
          "when": "view == acp-chat && acp.sandboxEnabled",
          "group": "navigation@2"
        },
        {
          "command": "acp.cancelTurn",
          "when": "view == acp-chat && acp.turnInProgress",
          "group": "navigation@4"
        },
        {
          "command": "acp.disconnectAgent",
          "when": "view == acp-chat",
          "group": "navigation@5"
        },
        {
          "command": "acp.showLog",
          "when": "view == acp-chat"
        },
        {
          "command": "acp.showTraffic",
          "when": "view == acp-chat"
        },
        {
          "command": "acp.openDebugSnapshot",
          "when": "view == acp-chat",
          "group": "navigation@6"
        },
        {
          "command": "acp.restartAgent",
          "when": "view == acp-chat"
        }
      ],
      "view/item/context": [
        {
          "command": "acp.connectAgent",
          "when": "view == acp-sessions && viewItem == agent-disconnected",
          "group": "inline"
        },
        {
          "command": "acp.disconnectAgent",
          "when": "view == acp-sessions && viewItem == agent-connected",
          "group": "inline"
        },
        {
          "command": "acp.removeAgent",
          "when": "view == acp-sessions && viewItem =~ /^agent/"
        },
        {
          "command": "acp.connectAgentWithCurrentContext",
          "when": "view == acp-sessions && viewItem =~ /^agent/",
          "group": "context@1"
        },
        {
          "command": "acp.restartAgent",
          "when": "view == acp-sessions && viewItem == agent-connected"
        },
        {
          "command": "acp.refreshSessions",
          "when": "view == acp-sessions && viewItem =~ /^agent/",
          "group": "session@1"
        },
        {
          "command": "acp.copySessionId",
          "when": "view == acp-sessions && viewItem =~ /^session/",
          "group": "session@1"
        },
        {
          "command": "acp.openSessionWithCurrentContext",
          "when": "view == acp-sessions && viewItem =~ /^session/",
          "group": "inline"
        },
        {
          "command": "acp.forgetSession",
          "when": "view == acp-sessions && viewItem == session-local",
          "group": "session@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "damien.inlineChat.open",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "acp.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "acp.cancelTurn",
        "key": "escape",
        "when": "acp.turnInProgress"
      }
    ],
    "configuration": {
      "title": "ACP Client",
      "properties": {
        "acp.agents": {
          "type": "object",
          "description": "Agent configurations. Each key is the agent name, value has command, args, and env.",
          "default": {
            "GitHub Copilot": {
              "command": "npx",
              "args": [
                "@github/copilot-language-server@latest",
                "--acp"
              ],
              "env": {}
            },
            "Claude Code": {
              "command": "npx",
              "args": [
                "@agentclientprotocol/claude-agent-acp@latest"
              ],
              "env": {}
            },
            "Gemini CLI": {
              "command": "npx",
              "args": [
                "@google/gemini-cli@latest",
                "--experimental-acp"
              ],
              "env": {}
            },
            "Qwen Code": {
              "command": "npx",
              "args": [
                "@qwen-code/qwen-code@latest",
                "--acp",
                "--experimental-skills"
              ],
              "env": {}
            },
            "Auggie CLI": {
              "command": "npx",
              "args": [
                "@augmentcode/auggie@latest",
                "--acp"
              ],
              "env": {
                "AUGMENT_DISABLE_AUTO_UPDATE": "1"
              }
            },
            "Qoder CLI": {
              "command": "npx",
              "args": [
                "@qoder-ai/qodercli@latest",
                "--acp"
              ],
              "env": {}
            },
            "Codex CLI": {
              "command": "npx",
              "args": [
                "@zed-industries/codex-acp@latest"
              ],
              "env": {}
            },
            "Vibe": {
              "command": "vibe-acp",
              "args": [],
              "env": {}
            },
            "Cursor CLI": {
              "command": "agent",
              "args": [
                "acp"
              ],
              "env": {}
            },
            "Codex Sandcastle": {
              "transport": "sandcastle",
              "provider": "codex",
              "model": "gpt-5.4",
              "effort": "high",
              "env": {}
            },
            "Cursor Sandcastle": {
              "transport": "sandcastle",
              "provider": "cursor",
              "model": "composer-2",
              "env": {}
            },
            "OpenCode": {
              "command": "npx",
              "args": [
                "opencode-ai@latest",
                "acp"
              ],
              "env": {}
            },
            "OpenClaw": {
              "command": "npx",
              "args": [
                "openclaw",
                "acp"
              ],
              "env": {}
            },
            "Kiro CLI": {
              "command": "kiro-cli",
              "args": [
                "acp"
              ],
              "env": {}
            },
            "Hermes Agent": {
              "command": "hermes",
              "args": [
                "acp"
              ],
              "env": {}
            },
            "Pi Agent": {
              "command": "npx",
              "args": [
                "-y",
                "pi-acp"
              ],
              "env": {}
            }
          }
        },
        "acp.autoApprovePermissions": {
          "type": "string",
          "enum": [
            "ask",
            "allowAll"
          ],
          "default": "ask",
          "description": "Automatically approve agent permission requests. 'ask' always prompts, 'allowAll' approves everything."
        },
        "acp.defaultWorkingDirectory": {
          "type": "string",
          "default": "",
          "description": "Default working directory for agent sessions. Leave empty to use the current workspace folder."
        },
        "acp.logTraffic": {
          "type": "boolean",
          "default": true,
          "description": "Log all ACP protocol traffic to the output channel."
        },
        "acp.pipeline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable workspace-defined LangGraph pipeline agents from .acp/pipelines/*.yaml and agent teams from .acp/teams/*.yaml."
        },
        "acp.instructions.maxBytes": {
          "type": "number",
          "default": 262144,
          "description": "Maximum size in bytes for Markdown instruction files referenced by agent teams."
        },
        "acp.sandbox.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run pipeline workspace-changing steps inside isolated git worktrees with a promotion gate."
        },
        "acp.sandbox.directory": {
          "type": "string",
          "default": ".acp/sandboxes",
          "description": "Directory (relative to workspace) where sandbox worktrees are created."
        },
        "acp.sandbox.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Optional git ref used as the sandbox base. Empty uses current HEAD."
        },
        "acp.sandbox.autoCleanupOnReject": {
          "type": "boolean",
          "default": true,
          "description": "Remove the sandbox worktree automatically when changes are rejected."
        },
        "acp.sandbox.staleTtlMs": {
          "type": "number",
          "default": 86400000,
          "description": "Maximum age in milliseconds before a stale sandbox is eligible for cleanup."
        },
        "acp.sandbox.promotion.lintCommand": {
          "type": "string",
          "default": "",
          "description": "Optional shell command run in the sandbox worktree before promotion (for example npm run lint)."
        },
        "acp.sandbox.promotion.testCommand": {
          "type": "string",
          "default": "",
          "description": "Optional shell command run in the sandbox worktree before promotion (for example npm test)."
        },
        "acp.sandbox.promotion.requireChecksPass": {
          "type": "boolean",
          "default": false,
          "description": "Require lint/test checks to pass before applying sandbox changes."
        },
        "acp.sandbox.network.allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional host allowlist for sandbox network policy (application-level in v1)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsx": "vsce package",
    "compile-tests": "tsc -p . --outDir out --incremental false",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --max-warnings 0",
    "sandcastle:smoke:codex": "npm run compile && node scripts/sandcastle-smoke.mjs codex apply",
    "sandcastle:smoke:cursor": "npm run compile && node scripts/sandcastle-smoke.mjs cursor reject",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "vscode:dts": "vscode-dts dev"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "@ai-hero/sandcastle": "0.6.4",
    "@langchain/core": "^1.1.49",
    "@langchain/langgraph": "^1.4.2",
    "@vscode/extension-telemetry": "^1.5.0",
    "js-yaml": "^4.1.1",
    "marked": "^15.0.0",
    "minisearch": "^7.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/dts": "^0.4.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  },
  "enabledApiProposals": [
    "editorInsets"
  ]
}
